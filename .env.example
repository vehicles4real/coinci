# .env.example

# Infura API key for accessing Ethereum network
# Replace with your actual Infura API key
INFURA_API_KEY=your_infura_api_key_here

# Wallet mnemonic for accessing a wallet
# This should be kept secret and not shared
WALLET_MNEMONIC=your_wallet_mnemonic_here

# Private key for accessing a wallet
# WARNING: This is sensitive information and should be kept private
PRIVATE_KEY=your_private_key_here

# Etherscan API key for reading blockchain data
# Replace with your actual Etherscan API key
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Wallet addresses for transactions
# Replace with your actual wallet addresses
WALLET_ADDRESS_1=your_wallet_address_1_here
WALLET_ADDRESS_2=your_wallet_address_2_here

# Note: Always ensure your .env file is added to .gitignore to avoid exposing sensitive information in version control.